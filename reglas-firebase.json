{
  "rules": {
    "usuarios": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nickname']) && ((newData.child('partidosJugados').val() == data.child('partidosJugados').val() && newData.child('partidosGanados').val() == data.child('partidosGanados').val() && newData.child('partidosEmpatados').val() == data.child('partidosEmpatados').val() && newData.child('partidosPerdidos').val() == data.child('partidosPerdidos').val()) || (newData.child('ultimaActualizacion').val() === now && (!data.child('ultimaActualizacion').exists() || newData.child('ultimaActualizacion').val() - data.child('ultimaActualizacion').val() > 30000)))",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 12"
        },
        "email": { ".validate": "newData.isString()" },
        "fotoURL": { ".validate": "newData.isString()" },
        "descripcion": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "redSocial": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "partidosJugados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
        "partidosGanados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
        "partidosEmpatados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
        "partidosPerdidos": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
        "puntos": { ".validate": "newData.isNumber() && newData.val() == (newData.parent().child('partidosGanados').val() || 0) * 3 + (newData.parent().child('partidosEmpatados').val() || 0) - (newData.parent().child('partidosPerdidos').val() || 0) * 5" },
        "efectividad": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "rachaActual": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "mejorRacha": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() >= (newData.parent().child('rachaActual').val() || 0)" },
        "golesFavor": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && newData.val() <= data.val() + 15))" },
        "golesContra": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && newData.val() <= data.val() + 15))" },
        "enPartida": { ".validate": "newData.isBoolean()" },
        "logros": {
          "$logroId": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },
        "loginStreak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "ultimoLogin": { ".validate": "newData.isNumber()" },
        "historialPartidos": {
          "$partidoId": {
            "fecha": { ".validate": "newData.isNumber()" },
            "resultado": { ".validate": "newData.isString() && (newData.val() === 'ganar' || newData.val() === 'empate' || newData.val() === 'perder')" },
            "golesFavor": { ".validate": "newData.isNumber()" },
            "golesContra": { ".validate": "newData.isNumber()" }
          }
        },
        "onlineStats": {
          ".validate": "((newData.child('partidosJugados').val() == data.child('partidosJugados').val() && newData.child('partidosGanados').val() == data.child('partidosGanados').val() && newData.child('partidosEmpatados').val() == data.child('partidosEmpatados').val() && newData.child('partidosPerdidos').val() == data.child('partidosPerdidos').val()) || (newData.child('ultimaActualizacion').val() === now && (!data.child('ultimaActualizacion').exists() || newData.child('ultimaActualizacion').val() - data.child('ultimaActualizacion').val() > 30000)))",
          "partidosJugados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
          "partidosGanados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
          "partidosEmpatados": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
          "partidosPerdidos": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && (newData.val() == data.val() || newData.val() == data.val() + 1)))" },
          "puntos": { ".validate": "newData.isNumber() && newData.val() == (newData.parent().child('partidosGanados').val() || 0) * 3 + (newData.parent().child('partidosEmpatados').val() || 0) - (newData.parent().child('partidosPerdidos').val() || 0) * 5" },
          "efectividad": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "rachaActual": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "mejorRacha": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() >= (newData.parent().child('rachaActual').val() || 0)" },
          "golesFavor": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && newData.val() <= data.val() + 15))" },
          "golesContra": { ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || (data.exists() && newData.val() <= data.val() + 15))" },
          "ultimaActualizacion": { ".validate": "newData.isNumber() && newData.val() === now" },
          "historialPartidos": {
            "$partidoId": {
              "fecha": { ".validate": "newData.isNumber()" },
              "resultado": { ".validate": "newData.isString() && (newData.val() === 'ganar' || newData.val() === 'empate' || newData.val() === 'perder')" },
              "golesFavor": { ".validate": "newData.isNumber()" },
              "golesContra": { ".validate": "newData.isNumber()" },
              "online": { ".validate": "newData.isBoolean()" },
              "abandono": { ".validate": "newData.isBoolean()" }
            }
          }
        },
        "ultimaActualizacion": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "partidas": {
      ".read": "auth != null",
      "$codigo": {
        ".write": "auth != null",
        "codigo": { ".validate": "newData.isString() && newData.val().length === 6" },
        "creador": {
          "uid": { ".validate": "newData.isString()" },
          "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "fotoURL": { ".validate": "newData.isString()" },
          "listo": { ".validate": "newData.isBoolean()" }
        },
        "unido": {
          "uid": { ".validate": "newData.isString()" },
          "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "fotoURL": { ".validate": "newData.isString()" },
          "listo": { ".validate": "newData.isBoolean()" }
        },
        "estado": {
          ".validate": "newData.isString() && (newData.val() === 'esperando' || newData.val() === 'jugando' || newData.val() === 'terminada')"
        },
        "rapida": { ".validate": "newData.isBoolean()" },
        "creadoEn": { ".validate": "newData.isNumber()" },
        "ultimaActividad": { ".validate": "newData.isNumber()" },
        "resultado": {
          "ganador": { ".validate": "newData.isString()" },
          "golesJugador": { ".validate": "newData.isNumber()" },
          "golesRival": { ".validate": "newData.isNumber()" },
          "abandono": { ".validate": "newData.isBoolean()" }
        },
        "juego": {
          ".write": "auth != null",
          ".read": "auth != null"
        },
        "$other": { ".validate": true }
      }
    },
    "cola_rapido": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        "uid": { ".validate": "newData.isString()" },
        "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "fotoURL": { ".validate": "newData.isString()" },
        "partidaId": { ".validate": "newData.isString() && newData.val().length === 6" },
        "creadoEn": { ".validate": "newData.isNumber()" }
      }
    }
  }
}